# The alphabet to use:
# DNA, RNA or Protein
alphabet=Codon(letter=DNA)
genetic_code=Standard

DATA=APOBEC3G_primates

# ----------------------------------------------------------------
#         Alignment
# ----------------------------------------------------------------

input.data1=alignment(file = $(DATA).fasta, format = Fasta, sites_to_use = all)

# ----------------------------------------------------------------------------------------
#                                     Input tree file
# ----------------------------------------------------------------------------------------

input.tree1=user(file = hom_M0/$(DATA)_ML.dnd_1, format = Newick)

# --------------------------------------------------------
#                                     Optimization
# --------------------------------------------------------

output.lik=PerBranch(file=APOBEC3G_M1M2.tsv)

result = phylo1

alt_process=2 