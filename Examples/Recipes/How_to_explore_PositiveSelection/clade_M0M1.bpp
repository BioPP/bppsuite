RESULT_DIR=clade_M0M1

# The alphabet to use:
# DNA, RNA or Protein
alphabet=Codon(letter=DNA)
genetic_code=Standard

DATA=APOBEC3G_primates

# ----------------------------------------------------------------
#         Alignment
# ----------------------------------------------------------------

input.data1=alignment(format=Fasta, file=$(DATA).fasta, sites_to_use=all)

# ----------------------------------------------------------------
#                             Input tree file
# ----------------------------------------------------------------

## data is used to prune the tree to correct leaves
input.tree1=user(file=hom_M0/$(DATA)_ML.dnd_1, format=Newick, data=1)

# --------------------------------------------------------
#                Previous substitution process
# --------------------------------------------------------


param = hom_M0/$(DATA)_params.bpp

# --------------------------------------------------------
#                M1 model
# --------------------------------------------------------

model2 = YNGP_M1(kappa=YN98.kappa_1, frequencies=F3X4(1_Full.theta=YN98.1_Full.theta_1,1_Full.theta1=YN98.1_Full.theta1_1,1_Full.theta2=YN98.1_Full.theta2_1,2_Full.theta=YN98.2_Full.theta_1,2_Full.theta1=YN98.2_Full.theta1_1,2_Full.theta2=YN98.2_Full.theta2_1,3_Full.theta=YN98.3_Full.theta_1,3_Full.theta1=YN98.3_Full.theta1_1,3_Full.theta2=YN98.3_Full.theta2_1))

process1 = NonHomogeneous(model1=2, model1.nodes_id=16:33, model2=1, model2.nodes_id=(0:15,34:49),tree=1, rate=1, root_freq=1)

# --------------------------------------------------------
#                Links the data and the process
# --------------------------------------------------------

phylo1 = Single(process=1, data=1)

# --------------------------------------------------------
#                                     Optimization
# --------------------------------------------------------

# Method to use for optimizing numerical parameters:
# - None, no optimization performed
# - DB derivatives for branch lengths + Brent for other parameters
# - FullD derivatives for all parameters, using numerical derivatives for non-branch lengths parameters.

optimization = FullD(derivatives=Newton)

# Set the quantity of output to the screen:
optimization.verbose = 3

# Parameters to ignore (for instance equilibrium frequencies)
optimization.ignore_parameters = BrLen, *_1

# Maximum number of likelihood evaluations:
optimization.max_number_f_eval = 1000

# Precision to reach:
optimization.tolerance = 0.0001

# idem for error or warning messages:
optimization.message_handler = $(RESULT_DIR)/messages

# A file where to dump optimization steps (a file path or std for standard output)
optimization.profiler = $(RESULT_DIR)/profile

# Should we write the resulting tree? none or file name.
output.tree.file = $(RESULT_DIR)/$(DATA)_ML.dnd
output.tree.format = Newick

# Alignment information log file (site specific rates, etc):
output.infos = $(RESULT_DIR)/$(DATA)_infos.txt

# Write numerical parameter estimated values:
output.estimates = $(RESULT_DIR)/$(DATA)_params.bpp

# Backup file
optimization.backup.file = $(RESULT_DIR)/$(DATA)_params.bup
