DATA = APOBEC3G_primates

OUTPUTDIR = hom_M2

# Sequences:

# The alphabet to use:
# DNA, RNA or Protein
alphabet = Codon(letter=DNA)

# The sequence file to use (sequences must be aligned!)
input.data1=alignment(file = $(DATA).fasta, format = Fasta, sites_to_use = all)


# ----------------------------------------------------------------------------------------
#                                     Input tree file
# ----------------------------------------------------------------------------------------

# user or random
input.tree1=user(file = hom_M0/$(DATA).ml_h.dnd_1, format = Newick)

# ----------------------------------------------------------------------------------------
#                                     Model specification
# ----------------------------------------------------------------------------------------
# See the manual for a description of the syntax and available options.
#

param = hom_M0/$(DATA).ml_h.params.bpp

model2 = YNGP_M2(kappa=YN98.kappa_1, omega=0.05, frequencies = F3X4(1_Full.theta  =YN98.1_Full.theta_1,1_Full.theta1 =YN98.1_Full.theta1_1,1_Full.theta2 =YN98.1_Full.theta2_1,2_Full.theta  =YN98.2_Full.theta_1 ,2_Full.theta1 =YN98.2_Full.theta1_1,2_Full.theta2 =YN98.2_Full.theta2_1,3_Full.theta  =YN98.3_Full.theta_1,3_Full.theta1 =YN98.3_Full.theta1_1,3_Full.theta2 =YN98.3_Full.theta2_1))

process1 = Homogeneous(model=2, tree=1, rate=1)

phylo1 = Single(process=1, data=1)


# ----------------------------------------------------------------------------------------
#                                     Optimization
# ----------------------------------------------------------------------------------------

# Should we reestimate likelihood parameters? Tree topology will not be optimized.
# (recommanded)
# Method to use for optimizing numerical parameters:
# - None, no optimization performed
# - DB derivatives for branch lengths + Brent for other parameters
# - FullD derivatives for all parameters, using numerical derivatives for non-branch lengths parameters.
optimization = FullD(derivatives=Newton)

# Tell if the parameter should be transformed in order to remove constraints.
# This can improves the optimization, but might be a bit slower.
optimization.reparametrization = no

# Final optimization step, may be useful if numerical derivatives are used:
# powell or simplex or none.
optimization.final = none

# Set the quantity of output to the screen:
optimization.verbose = 3

# Parameters to ignore (for instance equilibrium frequencies)
optimization.ignore_parameters = *_1

# Maximum number of likelihood evaluations:
optimization.max_number_f_eval = 10000

# Precision to reach:
optimization.tolerance = 0.00001

# idem for error or warning messages:
optimization.message_handler = $(OUTPUTDIR)/$(DATA).ml_h.messages

# A file where to dump optimization steps (a file path or std for standard output)
optimization.profiler = $(OUTPUTDIR)/$(DATA).ml_h.profile


# Should we write the resulting tree? none or file name.
output.tree.file = $(OUTPUTDIR)/$(DATA).ml_h.dnd
output.tree.format = Newick

# Alignment information log file (site specific rates, etc):
output.infos = $(OUTPUTDIR)/$(DATA).ml_h.infos

# Write numerical parameter estimated values:
output.estimates = $(OUTPUTDIR)/$(DATA).ml_h.params.bpp

